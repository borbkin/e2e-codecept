{
  "name": "e2e-codecept",
  "version": "1.0.0",
  "description": "E2E tests for automationexercise.com powered by CodeceptJS and Playwright",
  "scripts": {
    "test": "npm run test:ui",
    "test:ui": "HEADLESS=true npx codeceptjs run --plugins allure --steps",
    "test:headed": "HEADLESS=false npx codeceptjs run --plugins allure --steps",
    "test:allure": "npx allure generate allure-results --clean -o allure-report",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint . --ext .ts",
    "list": "npx codeceptjs list"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borbkin/e2e-codecept.git"
  },
  "keywords": [],
  "author": "borbkin",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/borbkin/e2e-codecept/issues"
  },
  "homepage": "https://github.com/borbkin/e2e-codecept#readme",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "allure-codeceptjs": "^3.2.1",
    "allure-commandline": "^2.34.0",
    "codeceptjs": "^3.7.3",
    "eslint": "^8.57.1",
    "playwright": "^1.52.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@faker-js/faker": "^9.7.0",
    "axios": "^1.8.3"
  }
}
